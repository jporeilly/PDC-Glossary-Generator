  "tag_rules": [
    {
      "pattern": "\\bph\\b|turbidity|chlorine|\\blead\\b|contaminant|water.?quality|violation|\\bepa\\b|hardness|nitrate",
      "tags": [
        "water-quality",
        "compliance"
      ]
    },
    {
      "pattern": "pipe|pump|valve|reservoir|tank|gallons|\\bflow\\b|cubic",
      "tags": [
        "water-system",
        "asset",
        "operational"
      ]
    },
    {
      "pattern": "\\bgis\\b|geospatial|spatial|geographic|\\bmap(s|ping)?\\b|parcel|easement|right.?of.?way",
      "tags": [
        "gis",
        "spatial",
        "asset"
      ]
    },
    {
      "pattern": "scada|telemetry|supervisory|\\brtu\\b|\\bplc\\b|sensor|remote.?monitor",
      "tags": [
        "scada",
        "operational",
        "telemetry"
      ]
    },
    {
      "pattern": "inspect|survey|field.?report|site.?visit",
      "tags": [
        "inspection",
        "field-ops"
      ]
    },
    {
      "pattern": "correspond|\\bletter\\b|notice|\\bmemo\\b|inquiry|communication|email",
      "tags": [
        "correspondence",
        "records"
      ]
    },
    {
      "pattern": "hydrolog|watershed|groundwater|aquifer|\\bwell\\b|reservoir|source.?water",
      "tags": [
        "hydrology",
        "water-quality"
      ]
    },
    {
      "pattern": "maintenance|work.?order|repair|service.?request|\\bmain.?break|leak",
      "tags": [
        "maintenance",
        "operational"
      ]
    },
    {
      "pattern": "outage|\\bincident\\b|emergency|spill|overflow",
      "tags": [
        "incident",
        "operational"
      ]
    },
    {
      "pattern": "permit|licen[cs]e|certificat",
      "tags": [
        "permit",
        "compliance"
      ]
    },
    {
      "pattern": "\\bland\\b|property|acquisition|zoning",
      "tags": [
        "land",
        "asset"
      ]
    },
    {
      "pattern": "\\bplan(s|ning)?\\b|design|drawing|schematic|as.?built|engineering",
      "tags": [
        "engineering",
        "asset"
      ]
    }
  ],

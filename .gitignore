# Python
__pycache__/
*.pyc
.venv/
venv/

# Lab / app runtime secrets — commit only the .env.example files
.env

# OS cruft
.DS_Store
Thumbs.db

# Local Claude settings
.claude/

# Word/Office lock files
~$*

# scenario-installed runtime bulk-load CSV
glossary_generator/datasources.csv

# React frontend build artifacts
frontend/node_modules/
frontend/dist/

# local state backups taken before destructive resets (never committed)
state-backup-*/

# pdc-remote (remote/) local state - config, keys, checkpoints, JWTs, logs
remote/pdc-remote.env
remote/.state/
remote/logs/

# desktop shell (Tauri): vendored runtime, staged app tree and Rust build output
desktop/node_modules/
desktop/src-tauri/vendor/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# scenario people seed - kept local at the user's request
glossary_generator/domain_packs/water_utility.people.json

# setuptools build metadata from `pip install -e .` (the dev venv arrangement
# stage-app.ps1 assumes). Regenerated on demand; never part of a build.
*.egg-info/

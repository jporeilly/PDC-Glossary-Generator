# ---------------------------------------------------------------------------
# pdc-remote configuration
#
# Copy to pdc-remote.env, or just run: .\pdc-remote.ps1 config
# pdc-remote.env is gitignored - it never leaves this machine.
#
# Precedence: KEY=VALUE argument > pdc-remote.env > defaults in pdc-remote.ps1
#   .\pdc-remote.ps1 reset VM_HOST=10.0.0.5
#
# Environment variables are expanded, so %USERPROFILE% works.
#
# NOTE: no passwords live here, by design. SSH is key-only; the PDC admin
# password is prompted for at the moment it is needed and never stored.
# ---------------------------------------------------------------------------

# --- the VM ----------------------------------------------------------------
VM_HOST=192.168.1.200

# The LINUX account on the VM - not a PDC or Keycloak login.
# If the console auto-logs-in and you do not know the name, type 'whoami'
# at the VM console and use whatever it prints.
VM_USER=

SSH_PORT=22

# Dedicated key, generated by '.\pdc-remote.ps1 enroll'.
SSH_KEY=%USERPROFILE%\.ssh\id_ed25519_pdc

# --- the PDC deployment ----------------------------------------------------
PDC_DIR=/opt/pentaho/pdc-docker-deployment
PDC_HOST=https://pentaho.io
VOLUME_PREFIX=pdc_
CONTAINER_PREFIX=pdc-

# Which copy of the reset script gets uploaded. Relative paths resolve against
# remote\, so the default is the one in the repo root - the VM always runs
# whatever is committed here.
RESET_SCRIPT=..\pdc-reset.sh

# --- API paths -------------------------------------------------------------
# Verified on the 11.0.0 demo build 2026-08-06: /api/public/ returns 404
# (Traefik has no router for it) while /api/ and /swagger/ are routed.
# Keep in step with SWAGGER_PATH / LICENSE_PATH in ..\pdc-reset.sh.
SWAGGER_PATH=/swagger/
LICENSE_PATH=/api/v2/licensing/uploadLicense

# --- optional: offline licence upload (.\pdc-remote.ps1 license) -----------
# Path to the .bin ON THE VM. Leave empty to do it through Swagger instead
# (see 'token' for the JWT you will need).
LICENSE_BIN=
DEVICE_ID=pdc-demo

# --- Keycloak (used by token, license and health) --------------------------
KC_REALM=pdc
KC_CLIENT=pdc-client
PDC_ADMIN_USER=admin

# --- tuning ----------------------------------------------------------------
# Seconds to wait for fe/public-api during verification.
WAIT_TIMEOUT=600
# Port used by the enroll-http key-delivery fallback.
ENROLL_PORT=8099
